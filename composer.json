{
  "name": "djosend/php-sdk",
  "description": "PHP client for the Djosend Messages API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/djosend/djosend-php-sdk",
  "keywords": ["djosend", "sms", "messaging", "sdk"],
  "support": {
    "issues": "https://github.com/djosend/djosend-php-sdk/issues",
    "source": "https://github.com/djosend/djosend-php-sdk"
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.9 || ^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "Djosend\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Djosend\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  }
}
